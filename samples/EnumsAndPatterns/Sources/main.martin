enum Result {
    case success(Int?)
    case failure(String)
}

func report(_ result: Result) {
    switch result {
        case .success(.some(let value)): print(value)
        case .success(nil): print("empty")
        case .failure(let message): print(message)
    }
}

func main() {
    report(Result.success(7))
    report(Result.success(nil))
    report(Result.failure("failed"))
}
